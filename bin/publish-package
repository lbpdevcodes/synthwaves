#!/usr/bin/env bash
set -euo pipefail

APP_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PLATFORM="${PLATFORM:-linux/amd64}"
REGISTRY_IMAGE="${REGISTRY_IMAGE:-100.108.65.56:80/lbp/synthwaves.fm}"
REGISTRY="${REGISTRY_IMAGE%%/*}"

usage() {
  printf 'Usage: %s VERSION --forgejo\n' "${0##*/}"
  printf '\n'
  printf 'Examples:\n'
  printf '  %s v0.1.3 --forgejo\n' "${0##*/}"
  printf '  %s --forgejo v0.1.3\n' "${0##*/}"
  printf '\n'
  printf 'Environment overrides:\n'
  printf '  PLATFORM=%s\n' "$PLATFORM"
  printf '  REGISTRY_IMAGE=%s\n' "$REGISTRY_IMAGE"
}

VERSION=""
FORGEJO=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --forgejo)
      FORGEJO="1"
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --*)
      printf 'Unknown option: %s\n\n' "$1" >&2
      usage >&2
      exit 1
      ;;
    *)
      if [ -n "$VERSION" ]; then
        printf 'Unexpected argument: %s\n\n' "$1" >&2
        usage >&2
        exit 1
      fi
      VERSION="$1"
      ;;
  esac
  shift
done

if [ -z "$VERSION" ] || [ -z "$FORGEJO" ]; then
  usage >&2
  exit 1
fi

cd "$APP_ROOT"

PUSH_ARGS=(--push)
if [ "${REGISTRY##*:}" = "80" ]; then
  PUSH_ARGS=(--output type=image,push=true,registry.insecure=true)
fi

if ! docker buildx build \
  --platform "$PLATFORM" \
  --provenance=false \
  --sbom=false \
  -t "$REGISTRY_IMAGE:$VERSION" \
  -t "$REGISTRY_IMAGE:latest" \
  "${PUSH_ARGS[@]}" \
  .; then
  printf '\nPublish failed while pushing %s.\n' "$REGISTRY_IMAGE" >&2
  printf 'Make sure Docker is logged in and your Forgejo user/token can write packages:\n' >&2
  printf '  docker login %s\n' "$REGISTRY" >&2
  printf '\n' >&2
  printf 'If this is a new package, verify package creation is allowed for this owner/org.\n' >&2
  exit 1
fi
