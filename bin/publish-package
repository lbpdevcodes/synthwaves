#!/usr/bin/env bash
set -euo pipefail

APP_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PLATFORM="${PLATFORM:-linux/amd64}"
REGISTRY_IMAGE="${REGISTRY_IMAGE:-forge.lbp.dev/lbp/synthwaves.fm}"

usage() {
  printf 'Usage: %s VERSION --forgejo\n' "${0##*/}"
  printf '\n'
  printf 'Examples:\n'
  printf '  %s v0.1.3 --forgejo\n' "${0##*/}"
  printf '  %s --forgejo v0.1.3\n' "${0##*/}"
  printf '\n'
  printf 'Environment overrides:\n'
  printf '  PLATFORM=%s\n' "$PLATFORM"
  printf '  REGISTRY_IMAGE=%s\n' "$REGISTRY_IMAGE"
}

VERSION=""
FORGEJO=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --forgejo)
      FORGEJO="1"
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --*)
      printf 'Unknown option: %s\n\n' "$1" >&2
      usage >&2
      exit 1
      ;;
    *)
      if [ -n "$VERSION" ]; then
        printf 'Unexpected argument: %s\n\n' "$1" >&2
        usage >&2
        exit 1
      fi
      VERSION="$1"
      ;;
  esac
  shift
done

if [ -z "$VERSION" ] || [ -z "$FORGEJO" ]; then
  usage >&2
  exit 1
fi

cd "$APP_ROOT"

docker buildx build \
  --platform "$PLATFORM" \
  --provenance=false \
  --sbom=false \
  -t "$REGISTRY_IMAGE:$VERSION" \
  -t "$REGISTRY_IMAGE:latest" \
  --push \
  .
