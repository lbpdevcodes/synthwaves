<% content_for :meta_title, "#{@album.title} by #{@album.artist.name} — synthwaves.fm" %>
<% content_for :meta_description, "#{@album.artist.name} · #{@album.year} · #{@album.genre} · #{pluralize(@total_tracks, 'track')} · #{format_duration(@total_duration)}" %>
<% if @album.cover_image.attached? %>
  <% content_for :meta_image, og_image_url_for(@album.cover_image) %>
<% end %>
<% content_for :meta_type, "music.album" %>

<div class="w-full" data-controller="play-all">
  <div class="mb-6">
    <%= render Button::Component.new(label: "← Albums", behavior: :navigation, link_url: albums_path, style: :link) %>
  </div>
  <div class="flex flex-col sm:flex-row items-start gap-4 sm:gap-6 mb-8">
    <%= cover_image_or_placeholder(@album.cover_image, size: :large, lazy: false) %>
    <div>
      <h1 class="text-3xl font-bold font-display text-white"><%= @album.title %></h1>
      <p class="text-lg text-gray-400"><%= link_to @album.artist.name, artist_path(@album.artist), class: "hover:underline" %></p>
      <% if @display_year %>
        <p class="text-gray-400"><%= @display_year %></p>
      <% end %>
      <% if @genre_tags.any? %>
        <div class="flex flex-wrap gap-1.5 mt-1">
          <% @genre_tags.each do |tag| %>
            <span class="px-2 py-0.5 text-xs rounded-full bg-gray-700 text-gray-300"><%= tag.titleize %></span>
          <% end %>
        </div>
      <% elsif @album.genre.present? %>
        <p class="text-gray-400"><%= @album.genre %></p>
      <% end %>
      <p class="text-sm text-gray-400 mt-2"><%= pluralize(@total_tracks, "track") %> &middot; <%= format_duration(@total_duration) %></p>
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <%= render Button::Component.new(size: :small, data: { action: "play-all#playAll" }, extra_classes: "gap-1") do %>
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M6.3 2.84A1.5 1.5 0 004 4.11v11.78a1.5 1.5 0 002.3 1.27l9.344-5.891a1.5 1.5 0 000-2.538L6.3 2.84z"/></svg>
          Play All
        <% end %>
        <%= render "favorites/button", favorable: @album, favorited: Current.user.favorites.exists?(favorable: @album) %>
        <%= render BulkPlaylistMenu::Component.new(
              tracks: @all_tracks,
              playlists: current_user_playlists,
              new_playlist_name: @album.title
            ) %>
        <% if Current.user.admin? %>
          <%= render "albums/merge_menu", album: @album %>
        <% end %>
        <%= render Dropdown::Component.new(position: :left, width: "w-56") do |dropdown| %>
          <% dropdown.with_trigger do %>
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-white bg-gray-700 hover:bg-gray-600 rounded-lg transition-colors">
              More
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M10 6a2 2 0 110-4 2 2 0 010 4zm0 6a2 2 0 110-4 2 2 0 010 4zm0 6a2 2 0 110-4 2 2 0 010 4z"/></svg>
            </span>
          <% end %>
          <%= button_to "Export ZIP", downloads_path(downloadable_type: "Album", downloadable_id: @album.id), class: "block w-full text-left px-4 py-2 text-sm text-white hover:bg-gray-700 hover:text-neon-cyan" %>
          <%= button_to "Fetch cover", fetch_cover_album_path(@album), class: "block w-full text-left px-4 py-2 text-sm text-white hover:bg-gray-700 hover:text-neon-cyan" %>
          <% if @album.youtube_playlist_url.present? %>
            <%= button_to "Refresh from YouTube", refresh_album_path(@album), class: "block w-full text-left px-4 py-2 text-sm text-white hover:bg-gray-700 hover:text-neon-cyan" %>
          <% end %>
          <% if @album.tracks.where.not(youtube_video_id: [nil, ""]).where.missing(:audio_file_attachment).any? %>
            <%= button_to "Download Audio", download_audio_album_path(@album), class: "block w-full text-left px-4 py-2 text-sm text-white hover:bg-gray-700 hover:text-neon-cyan" %>
          <% end %>
          <% if Current.user.admin? %>
            <%= render Button::Component.new(label: "Edit", behavior: :navigation, link_url: edit_album_path(@album), style: :menu_item) %>
            <%= button_to "Delete", album_path(@album), method: :delete, class: "block w-full text-left px-4 py-2 text-sm text-red-400 hover:bg-gray-700", data: { turbo_confirm: "Delete \"#{@album.title}\" and all its tracks? This cannot be undone." } %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
  <turbo-frame id="album-tracks" data-turbo-action="advance">
    <form action="<%= album_path(@album) %>" method="get" data-controller="search" data-search-target="form" class="mb-4 flex items-center gap-3">
      <label for="sort" class="text-sm text-gray-400 font-medium">Sort by</label>
      <select name="sort" id="sort" data-action="change->search#submit" class="text-sm rounded-lg border border-gray-600 bg-gray-700 text-white px-3 py-2 focus:outline-neon-cyan">
        <% Track::ALBUM_SORT_OPTIONS.each do |value, label| %>
          <option value="<%= value %>" <%= "selected" if value == @sort %>><%= label %></option>
          <% end %>
        </select>
        <select name="direction" id="direction" data-action="change->search#submit" class="text-sm rounded-lg border border-gray-600 bg-gray-700 text-white px-3 py-2 focus:outline-neon-cyan">
          <option value="asc" <%= "selected" if @direction == "asc" %>>Ascending</option>
        <option value="desc" <%= "selected" if @direction == "desc" %>>Descending</option>
      </select>
    </form>

    <div class="bg-gray-800 rounded-lg border border-gray-700">
      <% @tracks.each do |track| %>
        <%= render TrackRow::Component.new(track: track, number: (@sort == "disc_number" ? track.track_number : nil), link_title: true, link_subtitle: true, show_album: false, hide_artist_if: @album.artist) do |c| %>
          <% c.with_trailing do %>
            <% if track.audio_file.attached? %>
              <%= link_to download_track_path(track), class: "text-gray-400 hover:text-neon-cyan", title: "Download" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
              <% end %>
            <% end %>
            <%= render "favorites/button", favorable: track, favorited: @favorited_track_ids.include?(track.id) %>
            <%= render "playlist_tracks/add_menu", track: track, playlists: current_user_playlists %>
          <% end %>
        <% end %>
      <% end %>
    </div>
            <% if @pagy.pages > 1 %>
              <div class="mt-6 flex justify-center">
                <%== @pagy.series_nav %>
              </div>
            <% end %>
          </turbo-frame>

          <% if @album.musicbrainz_release_id.present? %>
            <turbo-frame id="album-tracks-merged" src="<%= missing_tracks_album_path(@album) %>" loading="lazy">
              <p class="text-sm text-gray-500 mt-4">Checking MusicBrainz for missing tracks...</p>
            </turbo-frame>
          <% end %>
        </div>
