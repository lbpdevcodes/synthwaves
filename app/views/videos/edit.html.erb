<div class="w-full max-w-lg">
  <h1 class="text-3xl font-bold font-display mb-6">Edit Video</h1>

  <%= form_with model: @video, class: "space-y-4" do |f| %>
    <% if @video.errors.any? %>
      <div class="bg-red-900/20 border border-red-800 rounded-lg p-4">
        <ul class="text-sm text-red-400">
          <% @video.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :title, class: "block text-sm font-medium text-gray-400 mb-1" %>
      <%= f.text_field :title, class: "w-full rounded-lg bg-gray-800 border-gray-700 text-white focus:outline-neon-cyan px-3 py-2 text-sm border" %>
    </div>

    <div>
      <%= f.label :description, class: "block text-sm font-medium text-gray-400 mb-1" %>
      <%= f.text_area :description, rows: 3, class: "w-full rounded-lg bg-gray-800 border-gray-700 text-white focus:outline-neon-cyan px-3 py-2 text-sm border" %>
    </div>

    <div class="grid grid-cols-2 gap-3">
      <div>
        <%= f.label :video_type, "Type", class: "block text-sm font-medium text-gray-400 mb-1" %>
        <%= f.select :video_type, video_type_options, { include_blank: "Other" }, class: "w-full rounded-lg bg-gray-800 border-gray-700 text-white focus:outline-neon-cyan px-3 py-2 text-sm border" %>
      </div>
      <div>
        <%= f.label :year, class: "block text-sm font-medium text-gray-400 mb-1" %>
        <%= f.number_field :year, min: 1888, max: Date.current.year + 5, class: "w-full rounded-lg bg-gray-800 border-gray-700 text-white focus:outline-neon-cyan px-3 py-2 text-sm border" %>
      </div>
    </div>

    <div>
      <%= f.label :genre_names, "Genres", class: "block text-sm font-medium text-gray-400 mb-1" %>
      <%= f.text_field :genre_names, value: @video.genre_names.join(", "), placeholder: "action, comedy", class: "w-full rounded-lg bg-gray-800 border-gray-700 text-white focus:outline-neon-cyan px-3 py-2 text-sm border" %>
      <p class="mt-1 text-xs text-gray-500">Separate genres with commas.</p>
    </div>

    <div>
      <%= f.label :cover_image, "Poster", class: "block text-sm font-medium text-gray-400 mb-1" %>
      <% if @video.cover_image.attached? %>
        <div class="mb-2">
          <%= image_tag @video.cover_image, alt: "Current poster", class: "w-20 aspect-[2/3] rounded-lg object-cover" %>
        </div>
      <% end %>
      <%= f.file_field :cover_image, accept: "image/*", class: "w-full text-sm text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-gray-700 file:text-white hover:file:bg-gray-600 file:cursor-pointer" %>
      <p class="mt-1 text-xs text-gray-500">Optional. Without one, the video shows a frame from itself.</p>
    </div>

    <div>
      <%= f.label :folder_id, "Collection", class: "block text-sm font-medium text-gray-400 mb-1" %>
      <%= f.select :folder_id, folder_select_options, { include_blank: "(No collection)" }, class: "w-full rounded-lg bg-gray-800 border-gray-700 text-white focus:outline-neon-cyan px-3 py-2 text-sm border" %>
    </div>

    <div class="grid grid-cols-2 gap-3">
      <div>
        <%= f.label :season_number, "Season", class: "block text-sm font-medium text-gray-400 mb-1" %>
        <%= f.number_field :season_number, min: 0, class: "w-full rounded-lg bg-gray-800 border-gray-700 text-white focus:outline-neon-cyan px-3 py-2 text-sm border" %>
      </div>
      <div>
        <%= f.label :episode_number, "Episode", class: "block text-sm font-medium text-gray-400 mb-1" %>
        <%= f.number_field :episode_number, min: 0, class: "w-full rounded-lg bg-gray-800 border-gray-700 text-white focus:outline-neon-cyan px-3 py-2 text-sm border" %>
      </div>
      <p class="col-span-2 -mt-1 text-xs text-gray-500">A collection lists its videos in season and episode order.</p>
    </div>

    <div>
      <%= f.submit "Save", class: "px-4 py-2 bg-neon-pink text-white rounded-lg hover:shadow-neon-pink cursor-pointer" %>
      <%= render Button::Component.new(label: "Cancel", behavior: :navigation, link_url: video_path(@video), style: :ghost) %>
    </div>
  <% end %>

  <section class="mt-10 space-y-4">
    <h2 class="text-xl font-bold font-display">Subtitles</h2>

    <% if @video.subtitles.any? %>
      <ul class="divide-y divide-gray-700 rounded-lg border border-gray-700 bg-gray-800">
        <% @video.subtitles.each do |subtitle| %>
          <li class="flex items-center justify-between gap-3 px-4 py-2 text-sm">
            <span class="text-white">
              <%= subtitle.label %>
              <% if subtitle.language.present? %><span class="text-gray-400">· <%= subtitle.language %></span><% end %>
            </span>
            <%= button_to "Delete", video_subtitle_path(@video, subtitle), method: :delete,
                  data: { turbo_confirm: "Remove the #{subtitle.label} subtitles?" },
                  class: "text-red-400 hover:text-red-300 cursor-pointer" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-gray-400">No subtitles yet. The player's captions menu lists the ones you add here.</p>
    <% end %>

    <%= form_with scope: :subtitle, url: video_subtitles_path(@video), multipart: true, class: "space-y-3" do |f| %>
      <div>
        <%= f.label :file, "Subtitle file (.srt or .vtt)", class: "block text-sm font-medium text-gray-400 mb-1" %>
        <%= f.file_field :file, accept: ".srt,.vtt", class: "w-full text-sm text-gray-400" %>
      </div>
      <div>
        <%= f.label :label, "Label (optional)", class: "block text-sm font-medium text-gray-400 mb-1" %>
        <%= f.text_field :label, placeholder: "Read from the file name, e.g. English (SDH)", class: "w-full rounded-lg bg-gray-800 border-gray-700 text-white focus:outline-neon-cyan px-3 py-2 text-sm border" %>
      </div>
      <%= f.submit "Add subtitles", class: "px-4 py-2 bg-neon-cyan text-gray-900 rounded-lg cursor-pointer" %>
    <% end %>
  </section>
</div>
