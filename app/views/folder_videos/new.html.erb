<%= render layout: "shared/modal_or_page", locals: {title: "Add videos to #{@folder.name}"} do %>
  <% videos = @folder.videos_to_add %>
  <% if videos.empty? %>
    <p class="text-gray-400">Every one of your videos is already in <%= @folder.name %>.</p>
  <% else %>
    <%= form_with url: folder_videos_path(@folder), class: "space-y-4", data: { controller: "list-filter" } do |f| %>
      <% if @error %>
        <div class="bg-red-900/20 border border-red-800 rounded-lg p-4">
          <p class="text-sm text-red-400"><%= @error %></p>
        </div>
      <% end %>

      <input type="search" placeholder="Filter videos…" aria-label="Filter videos" autocomplete="off"
             data-list-filter-target="input" data-action="input->list-filter#filter"
             class="w-full rounded-lg bg-gray-800 border border-gray-700 px-3 py-2 text-white focus:outline-neon-cyan">

      <ul class="max-h-80 overflow-y-auto rounded-lg border border-gray-700 divide-y divide-gray-700">
        <% videos.each do |video| %>
          <li data-list-filter-target="item" data-filter-text="<%= video.title.downcase %>">
            <label class="flex items-center gap-3 px-3 py-2 cursor-pointer hover:bg-gray-800">
              <%= check_box_tag "video_ids[]", video.id, false, id: "add_video_#{video.id}",
                    class: "rounded border-gray-600 bg-gray-900 text-neon-pink focus:ring-neon-cyan" %>
              <span class="flex-1 truncate text-sm text-white"><%= video.title %></span>
              <% if video.folder %>
                <span class="shrink-0 text-xs text-gray-400">in <%= current_folder_tree.label(video.folder) %></span>
              <% end %>
            </label>
          </li>
        <% end %>
      </ul>
      <p class="hidden text-sm text-gray-400" data-list-filter-target="empty">No videos match.</p>

      <div class="flex items-center gap-3">
        <%= f.submit "Add videos", class: "px-4 py-2 bg-neon-pink text-white rounded-lg hover:shadow-neon-pink cursor-pointer" %>
        <% if turbo_frame_request? %>
          <button type="button" data-action="modal#close" class="px-4 py-2 text-gray-300 hover:text-white rounded-lg">Cancel</button>
        <% else %>
          <%= render Button::Component.new(label: "Cancel", behavior: :navigation, link_url: folder_path(@folder), style: :ghost) %>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
