<%= render layout: "shared/modal_or_page", locals: {title: "Upload tracks"} do %>
  <%= form_with url: track_uploads_path, class: "space-y-5",
        data: { controller: "bulk-upload", action: "submit->bulk-upload#submit",
                bulk_upload_label_value: "Upload", bulk_upload_finishing_label_value: "Adding tracks..." } do |f| %>
    <% if @upload.errors.any? %>
      <div class="bg-red-900/20 border border-red-800 rounded-lg p-4">
        <ul class="text-sm text-red-400">
          <% @upload.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <% if @upload.album %>
      <%= hidden_field_tag :album_id, @upload.album.id %>
      <p class="text-sm text-gray-400">Into <span class="text-white"><%= @upload.album.title %></span> by <span class="text-white"><%= @upload.album.artist.name %></span></p>
    <% else %>
      <%= hidden_field_tag :artist_id, @upload.artist.id %>
      <div>
        <%= label_tag :album_title, "Album by #{@upload.artist.name}", class: "block text-sm font-medium text-gray-400 mb-1" %>
        <%= text_field_tag :album_title, @upload.album_title, list: "artist-album-titles", autocomplete: "off",
              class: "w-full rounded-lg bg-gray-800 border border-gray-700 px-3 py-2 text-white focus:outline-neon-cyan" %>
        <datalist id="artist-album-titles">
          <% @upload.artist_album_titles.each do |title| %>
            <option value="<%= title %>"></option>
          <% end %>
        </datalist>
        <p class="mt-1 text-xs text-gray-500">Pick an existing album or type a new title.</p>
      </div>
    <% end %>

    <div>
      <label class="block text-sm font-medium text-gray-400 mb-1">Audio files</label>
      <input type="file" accept="audio/*,.flac,.m4a,.ogg,.wav" multiple required
             data-bulk-upload-target="input"
             data-action="change->bulk-upload#filesChanged"
             class="block w-full text-sm text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-neon-cyan/10 file:text-neon-cyan hover:file:bg-neon-cyan/20">
      <p class="mt-1 text-xs text-gray-500">Titles, track numbers and durations are read from each file's tags.</p>
    </div>

    <div data-bulk-upload-target="preview" class="hidden">
      <ul data-bulk-upload-target="list" class="space-y-1 text-sm text-gray-400 bg-gray-800/50 rounded-lg border border-gray-700 p-3 max-h-48 overflow-y-auto">
      </ul>
    </div>

    <div class="flex items-center gap-3">
      <%= f.submit "Upload", class: "px-4 py-2 bg-neon-pink text-white rounded-lg hover:shadow-neon-pink cursor-pointer disabled:opacity-60",
            data: { bulk_upload_target: "submit" } %>
      <% if turbo_frame_request? %>
        <button type="button" data-action="modal#close" class="px-4 py-2 text-gray-300 hover:text-white rounded-lg">Cancel</button>
      <% end %>
    </div>
  <% end %>
<% end %>
