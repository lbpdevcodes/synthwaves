<div class="w-full">
  <div class="mb-6">
    <%= render Button::Component.new(label: @folder.parent ? "← Back to #{@folder.parent.name}" : "← Back", behavior: :navigation,
          link_url: folder_parent_path(@folder), style: :link) %>
  </div>

  <div class="flex flex-col sm:flex-row items-start gap-6 mb-8">
    <% if (cover = @folder.cover) %>
      <%= image_tag cover, class: "w-32 h-32 rounded-lg object-cover" %>
    <% else %>
      <div class="w-32 h-32 rounded-lg bg-gray-800 flex items-center justify-center">
        <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
        </svg>
      </div>
    <% end %>

    <div class="flex-1">
      <h1 class="text-3xl font-bold font-display text-white"><%= @folder.name %></h1>
      <% if @folder.description.present? %>
        <p class="text-gray-400 mt-1"><%= @folder.description %></p>
      <% end %>
      <div class="mt-2 text-sm text-gray-400 space-x-4">
        <% if @subfolders.any? %>
          <span><%= pluralize(@subfolders.size, "collection") %></span>
        <% end %>
        <span><%= @folder.videos.count %> video(s)</span>
        <% if @processing_count > 0 %>
          <span class="text-neon-cyan"><%= @processing_count %> processing</span>
        <% end %>
        <% if @failed_count > 0 %>
          <span class="text-red-400"><%= @failed_count %> failed</span>
        <% end %>
      </div>
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <%= render "favorites/button", favorable: @folder, favorited: Current.user.favorites.exists?(favorable: @folder) %>
        <%= render Button::Component.new(label: "Upload videos", behavior: :navigation, link_url: new_folder_upload_path(@folder), turbo_frame: "modal") %>
        <%= render Button::Component.new(label: "Add videos", behavior: :navigation, link_url: new_folder_video_path(@folder), style: :secondary, turbo_frame: "modal") %>
        <%= render Dropdown::Component.new(position: :left, width: "w-48") do |dropdown| %>
          <% dropdown.with_trigger do %>
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-white bg-gray-700 hover:bg-gray-600 rounded-lg transition-colors">
              More
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M10 6a2 2 0 110-4 2 2 0 010 4zm0 6a2 2 0 110-4 2 2 0 010 4zm0 6a2 2 0 110-4 2 2 0 010 4z"/></svg>
            </span>
          <% end %>
          <%= render Button::Component.new(label: "Edit", behavior: :navigation, link_url: edit_folder_path(@folder), style: :menu_item, turbo_frame: "modal") %>
          <%= render Button::Component.new(label: "New collection", behavior: :navigation, link_url: new_folder_path(parent_id: @folder.id), style: :menu_item, turbo_frame: "modal") %>
          <%= button_to "Delete", folder_path(@folder), method: :delete,
                form: { data: { turbo_frame: "_top", turbo_confirm: folder_delete_confirmation(@folder) } },
                class: "block w-full text-left px-4 py-2 text-sm text-red-400 hover:bg-gray-700" %>
        <% end %>
      </div>
    </div>
  </div>

  <% if @subfolders.any? %>
    <section class="mb-8" data-subfolders>
      <h2 class="text-lg font-bold font-display text-white mb-4">Collections</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 collection-grid">
        <% @subfolders.each do |subfolder| %>
          <%= render FolderCard::Component.new(folder: subfolder) %>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @folder.videos.any? || @subfolders.none? %>
    <% if @subfolders.any? %>
      <h2 class="text-lg font-bold font-display text-white mb-4">Videos</h2>
    <% end %>
    <%= render "folders/videos" %>
  <% end %>
</div>
