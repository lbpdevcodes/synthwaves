<%# Delete for a form rendered by shared/modal_or_page. It submits as a full
    page so the destroy redirect replaces the page, not the modal frame. %>
<div class="mt-6 pt-4 border-t border-gray-700">
  <%= button_to "Delete", url, method: :delete,
        form: { data: { turbo_frame: "_top", turbo_confirm: confirm } },
        class: "px-4 py-2 text-sm font-medium text-red-400 bg-gray-700 hover:bg-gray-600 rounded-lg transition-colors" %>
</div>
