<%# The artist as a typed name, suggesting the owner's artists. A new name
    creates the artist when the form saves. %>
<%= form.label :artist_name, "Artist", class: "block text-sm font-medium text-gray-400 mb-1" %>
<%= form.text_field :artist_name, value: value, list: "library-artist-names", autocomplete: "off", class: "w-full rounded-lg bg-gray-800 border border-gray-700 px-3 py-2 text-white focus:outline-neon-cyan" %>
<datalist id="library-artist-names">
  <% library_artist_names.each do |name| %>
    <option value="<%= name %>"></option>
  <% end %>
</datalist>
