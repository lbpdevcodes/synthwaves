<%# A pencil over the top-right corner of a collection card, opening the edit
    form in the modal. It sits beside the card link, never inside it. %>
<%= link_to url, data: { turbo_frame: "modal" }, title: "Edit", aria: { label: "Edit #{name}" },
      class: "absolute top-2 right-2 z-10 p-1.5 rounded-full bg-gray-900/80 text-gray-300 hover:text-neon-cyan opacity-0 group-hover/card:opacity-100 focus:opacity-100 coarse:opacity-100 transition-opacity" do %>
  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
<% end %>
