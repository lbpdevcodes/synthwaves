<div class="mx-auto md:w-2/3 w-full">
  <% if notice = flash[:notice] %>
    <p class="py-2 px-3 bg-laser-green/10 border border-laser-green/20 mb-5 text-laser-green font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
  <% end %>

  <% if alert = flash[:alert] %>
    <p class="py-2 px-3 bg-red-500/10 border border-red-500/20 mb-5 text-red-400 font-medium rounded-lg inline-block" id="alert"><%= alert %></p>
  <% end %>

  <h1 class="font-bold font-display text-4xl">Sign in a TV</h1>

  <p class="mt-3 text-gray-400">
    Enter the code your TV shows. The TV will be signed in as <%= Current.user.email_address %>.
  </p>

  <%= form_with url: link_path, class: "contents" do |form| %>
    <div class="my-5">
      <%= form.label :code, "Code", class: "text-sm text-gray-400" %>
      <%= form.text_field :code, value: params[:code], required: true, autofocus: params[:code].blank?,
            autocomplete: "off", autocapitalize: "characters", spellcheck: false, placeholder: "ABCD-2345",
            class: "block shadow-sm rounded-md border border-gray-700 bg-gray-800 text-white font-mono uppercase tracking-widest focus:outline-neon-cyan px-3 py-2 mt-2 w-full" %>
    </div>

    <%= form.submit "Sign In #{@device_name || "TV"}", class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-neon-pink hover:shadow-neon-pink text-white inline-block font-medium cursor-pointer" %>
  <% end %>
</div>
