<% if downloadable? %>
  <%= link_to download_track_path(track), class: "text-gray-400 hover:text-neon-cyan coarse:p-2.5", title: "Download" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
  <% end %>
<% end %>
<%= render "favorites/button", favorable: track, favorited: favorited %>
<%= render "playlist_tracks/add_menu", track: track, playlists: helpers.current_user_playlists %>
