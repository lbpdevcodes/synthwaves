<div class="relative group/card">
  <%# Two card edges peeking out above, so a collection reads as many videos.
      List mode hides them. %>
  <div aria-hidden="true" class="collection-card-stack absolute inset-x-4 -top-2 h-1 rounded-t-lg border border-b-0 border-gray-700/70 bg-gray-800/40"></div>
  <div aria-hidden="true" class="collection-card-stack absolute inset-x-2 -top-1 h-1 rounded-t-lg border border-b-0 border-gray-700 bg-gray-800/60"></div>
  <%= render "shared/card_edit_link", url: helpers.edit_folder_path(folder), name: folder.name %>
  <%= link_to helpers.folder_path(folder), class: "relative group block h-full bg-gray-800/60 border border-gray-700 rounded-xl overflow-hidden hover:border-neon-cyan/50 hover:bg-gray-800 transition-all duration-200 collection-card", data: { turbo_frame: "_top" } do %>
    <div class="collection-card-inner">
      <div class="relative aspect-video bg-gray-900 collection-card-image">
        <% if (cover = folder.cover) %>
          <%= helpers.image_tag cover, class: "w-full h-full object-cover", loading: "lazy" %>
        <% else %>
          <div class="w-full h-full flex items-center justify-center">
            <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
            </svg>
          </div>
        <% end %>
      </div>
      <div class="p-3 collection-card-body">
        <h3 class="text-sm font-medium text-white truncate group-hover:text-neon-cyan transition-colors"><%= folder.name %></h3>
        <p class="text-xs text-gray-400 truncate mt-0.5"><%= count_line %></p>
      </div>
    </div>
  <% end %>
</div>
